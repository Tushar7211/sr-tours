# Password for the /admin page (set this in Vercel > Project > Settings > Environment Variables)
ADMIN_PASSWORD=choose-a-strong-password

# These two are added automatically when you connect "Upstash Redis" in Vercel > Storage.
# (If your integration names them UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN, that works too.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
